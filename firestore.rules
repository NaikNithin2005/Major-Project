rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'nithinnaikr2005@gmail.com' ||
          request.auth.token.email == 'admin@squishshield.local' ||
          request.auth.token.email == 'admin@shield.ai'
        ))
      );
    }

    // User Profile Documents & Nested Collections
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // Canonical Nested User Threat Detections: users/{userId}/threats/{threatId}
      match /threats/{threatId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create: if (isOwner(userId) || isAdmin()) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == userId);
        allow update: if (isOwner(userId) || isAdmin()) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == userId);
      }

      // Nested User Scans
      match /scans/{scanId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin()) &&
          (!('userId' in request.resource.data) || request.resource.data.userId == userId);
      }

      // Nested User Actions
      match /actions/{actionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Nested User Preferences (Settings persistence)
      match /preferences/{prefId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Top-Level Threat Events (isolated by userId field)
    match /threats/{threatId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // User Registered Devices
    match /devices/{deviceId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
        isAdmin()
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Explicit collection group rule: prevent non-admins from querying across all users' threat subcollections
    match /{path=**}/threats/{threatId} {
      allow read: if isAdmin();
    }
  }
}
