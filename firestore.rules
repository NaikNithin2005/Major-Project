rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'ADMIN' ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'nithinnaikr2005@gmail.com' ||
          request.auth.token.email == 'admin@squishshield.local' ||
          request.auth.token.email == 'admin@shield.ai'
        ))
      );
    }

    // User Profile Documents & Nested Collections
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      // Canonical Nested User Threat Detections: users/{userId}/threats/{threatId}
      match /threats/{threatId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Nested User Scans
      match /scans/{scanId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Nested User Actions
      match /actions/{actionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Top-Level Threat Events
    match /threats/{threatId} {
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // User Registered Devices
    match /devices/{deviceId} {
      allow read, write: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
