# Environment Variables Template
# Real-Time AI/ML-Based Quishing and Smishing Detection & Prevention System
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL!

# ================================
# Backend (FastAPI) Configuration
# ================================
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=YOUR_SUPER_SECRET_KEY_PLACEHOLDER

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quishing_smishing_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_PLACEHOLDER
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD_PLACEHOLDER@localhost:5432/quishing_smishing_db

# Firebase Admin Configuration (Backend Verification)
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_PLACEHOLDER
FIREBASE_PRIVATE_KEY_PATH=/path/to/firebase-credentials.json

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ================================
# AI Workspace Configuration
# ================================
AI_MODEL_DIR=./models
TINYBERT_MODEL_PATH=./models/tinybert_smishing.onnx
XGBOOST_MODEL_PATH=./models/xgboost_quishing.onnx
ISOLATION_FOREST_MODEL_PATH=./models/isolation_forest.onnx

# ================================
# Web Admin Dashboard (Next.js)
# ================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_PUBLIC_API_KEY_PLACEHOLDER
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN_PLACEHOLDER
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_PLACEHOLDER
