# Environment Variables Template
# Real-Time AI/ML-Based Quishing and Smishing Detection & Prevention System
# DO NOT COMMIT REAL SECRETS OR CREDENTIAL FILES TO VERSION CONTROL!

# ================================
# Backend (FastAPI) Configuration
# ================================
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-string

# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=squish_shield_db
POSTGRES_USER=squish_admin
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_PLACEHOLDER
DATABASE_URL=postgresql://squish_admin:YOUR_POSTGRES_PASSWORD_PLACEHOLDER@localhost:5432/squish_shield_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Firebase Admin Configuration (Backend Token Verification)
FIREBASE_PROJECT_ID=squish-shield
# Privileged Firebase Credentials Options (choose one for production):
# Option A: File path to service account JSON
# FIREBASE_CREDENTIALS=/etc/secrets/firebase-service-account.json
# Option B: Inline JSON string (e.g. from container secret manager)
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}
# Option C: Base64-encoded service account JSON
# FIREBASE_CREDENTIALS_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...

# Mock authentication (strictly blocked when ENVIRONMENT=production)
ALLOW_MOCK_AUTH=true

# Server-authoritative Admin Email Whitelist
ADMIN_EMAILS=admin@squishshield.local,security-lead@yourorg.com

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT=120
RATE_LIMIT_ADMIN=240

# ================================
# AI Model Assets & Artifacts
# ================================
AI_MODEL_DIR=./models
TINYBERT_MODEL_PATH=./models/tinybert_smishing.onnx
XGBOOST_MODEL_PATH=./models/xgboost_quishing.onnx
ISOLATION_FOREST_MODEL_PATH=./models/isolation_forest.onnx

# ================================
# Web Admin Dashboard (Next.js)
# ================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_PUBLIC_API_KEY_PLACEHOLDER
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN_PLACEHOLDER
NEXT_PUBLIC_FIREBASE_PROJECT_ID=squish-shield
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET_PLACEHOLDER
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID_PLACEHOLDER
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID_PLACEHOLDER
