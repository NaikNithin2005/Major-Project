# Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://squish_admin:YOUR_POSTGRES_PASSWORD@localhost:5432/squish_shield_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Authentication & Security
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-string
FIREBASE_PROJECT_ID=squish-shield

# Privileged Firebase Credentials Options (choose one for production):
# Option A: File path to service account JSON
# FIREBASE_CREDENTIALS=/etc/secrets/firebase-service-account.json
# Option B: Inline JSON string (e.g., from container secret manager)
# FIREBASE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"..."}
# Option C: Base64-encoded service account JSON
# FIREBASE_CREDENTIALS_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
# Option D: Google Application Default Credentials (ADC) automatically detected on GCP

# Mock authentication (strictly blocked in ENVIRONMENT=production)
ALLOW_MOCK_AUTH=true

# Admin Email Whitelist (Comma-separated server-authoritative admin accounts)
ADMIN_EMAILS=admin@squishshield.local,security-lead@yourorg.com

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting (requests per minute)
RATE_LIMIT=120
RATE_LIMIT_ADMIN=240
