# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres_dev_password@localhost:5432/quishing_smishing_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Authentication & Security
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-string
FIREBASE_PROJECT_ID=squish-shield
# FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json
ALLOW_MOCK_AUTH=true

# Rate Limiting
RATE_LIMIT=60
RATE_LIMIT_ADMIN=120
